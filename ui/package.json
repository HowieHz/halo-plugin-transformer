{
  "type": "module",
  "scripts": {
    "build": "run-s verify:spec-artifacts build:compiled",
    "build-only": "vite build",
    "build:compiled": "run-p type-check \"build-only {@}\" --",
    "dev": "vite build --mode development --watch",
    "fmt": "oxfmt \"**/*.{json,jsonc,yaml,md,css,js,ts,html,vue,less,scss}\" --ignore-path ../.gitignore",
    "fmt:check": "oxfmt \"**/*.{json,jsonc,yaml,md,css,js,ts,html,vue,less,scss}\" --check --ignore-path ../.gitignore",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint . --fix",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path ../.gitignore",
    "test:unit": "vitest --passWithNoTests",
    "type-check": "vue-tsc --build",
    "verify:spec-artifacts": "pnpm --dir .. verify:spec-artifacts"
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.26.0",
    "@halo-dev/components": "^2.26.0",
    "@halo-dev/ui-shared": "^2.26.0",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "compat-finder": "^2.1.0",
    "vue": "^3.5.41",
    "vue-router": "~5.1.0"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "^2.26.0",
    "@iconify-json/ri": "^1.2.10",
    "@tsconfig/node20": "^20.1.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@unocss/eslint-config": "^66.7.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-vue": "~10.10.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "sass": "^1.102.0",
    "typescript": "~6.0.3",
    "unocss": "^66.7.5",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "^11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
